#left {
    width: 3fr;
    border-right: solid $panel;
}

#items {
    height: 1fr;
}

#tally {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#right {
    width: 2fr;
    padding: 1 2;
}

#detail-name {
    text-style: bold;
    padding-bottom: 1;
}

.field-label {
    color: $text-muted;
    padding-top: 1;
}

ConfirmQuit {
    align: center middle;
}

#dialog {
    width: 60;
    height: auto;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#dialog-text {
    padding-bottom: 1;
}

#dialog-buttons {
    height: auto;
    align-horizontal: right;
}

#dialog-buttons Button {
    margin-left: 1;
}
