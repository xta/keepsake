# Copy to .env. One B2 key per bucket: listFiles + readFiles, never deleteFiles.

KEEPSAKE_ENDPOINT=https://s3.us-east-001.backblazeb2.com

KEEPSAKE_FAMILY_BUCKET=
KEEPSAKE_FAMILY_ID=
KEEPSAKE_FAMILY_KEY=

KEEPSAKE_ARCHIVE_BUCKET=
KEEPSAKE_ARCHIVE_ID=
KEEPSAKE_ARCHIVE_KEY=

# Add a bucket with another BUCKET/ID/KEY triple.
# The profile name is the middle word, lowercased: KEEPSAKE_FAMILY_* -> "family".

# Optional: default profile when --profile is omitted.
# KEEPSAKE_PROFILE=family
