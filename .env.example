# Copy to .env. One B2 key per bucket: listFiles + readFiles, never deleteFiles.

KEEPSAKE_ENDPOINT=https://s3.us-east-001.backblazeb2.com

KEEPSAKE_JANE_BUCKET=media-jane
KEEPSAKE_JANE_ID=
KEEPSAKE_JANE_KEY=

KEEPSAKE_JOHN_BUCKET=media-john
KEEPSAKE_JOHN_ID=
KEEPSAKE_JOHN_KEY=

# One bucket per person is the usual shape, but a profile is just a bucket --
# name them however you like. Add one with another BUCKET/ID/KEY triple.
# The profile name is the middle word, lowercased: KEEPSAKE_JANE_* -> "jane".

# Optional: default profile when --profile is omitted.
# KEEPSAKE_PROFILE=jane
