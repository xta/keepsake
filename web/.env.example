# Copy to .env.production (gitignored) and fill in. This is the only file that
# holds raw deployment secrets; .kamal/secrets.production reads from it.

# GitHub classic PAT with write:packages + read:packages, for ghcr.io.
# Fine-grained tokens do not work properly with the container registry.
KAMAL_REGISTRY_PASSWORD=

# Generate with: openssl rand -hex 32
# Hex only, deliberately: URL-special characters break DATABASE_URL.
KEEPSAKE_POSTGRES_PASSWORD=
