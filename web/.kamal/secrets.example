# Copy to .kamal/secrets.production (gitignored). Kamal reads
# .kamal/secrets.<destination> when invoked as `kamal deploy -d production`.
#
# No raw values belong in a secrets file. Put those in .env.production (also
# gitignored) and read them here, so there is exactly one file to protect.
#
# Format is dotenv: ${VAR} interpolation and $(command) substitution both work.

KAMAL_REGISTRY_PASSWORD=$(grep -m1 '^KAMAL_REGISTRY_PASSWORD=' .env.production | cut -d= -f2-)
KEEPSAKE_POSTGRES_PASSWORD=$(grep -m1 '^KEEPSAKE_POSTGRES_PASSWORD=' .env.production | cut -d= -f2-)

# Decrypts config/credentials.yml.enc, which holds secret_key_base and the
# Active Record Encryption keys -- so those never travel as environment vars.
RAILS_MASTER_KEY=$(cat config/master.key)

POSTGRES_PASSWORD=${KEEPSAKE_POSTGRES_PASSWORD}
DATABASE_URL=postgres://keepsake:${KEEPSAKE_POSTGRES_PASSWORD}@keepsake-db:5432/keepsake_production
