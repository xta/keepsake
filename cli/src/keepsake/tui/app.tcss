#left {
    width: 3fr;
    border-right: solid $panel;
}

#items {
    height: 1fr;
}

#tally {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#right {
    width: 2fr;
    padding: 1 2;
}

#detail-name {
    text-style: bold;
    padding-bottom: 1;
}

/* `height: auto` is load-bearing: the widget derives an aspect-correct height
   from whatever width it is given, so pinning both dimensions is what stretches
   a picture. The width is set in code (see `fit_width`) because a tall image
   needs a narrower one to stay inside the pane. Hidden entirely when there is
   no image, so the form does not sit under a permanent empty box. */
#thumb {
    width: 100%;
    height: auto;
    max-height: 14;
}

#thumb-note {
    height: auto;
    color: $text-muted;
}

.field-label {
    color: $text-muted;
    padding-top: 1;
}

ConfirmQuit {
    align: center middle;
}

#dialog {
    width: 60;
    height: auto;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#dialog-text {
    padding-bottom: 1;
}

#dialog-buttons {
    height: auto;
    align-horizontal: right;
}

#dialog-buttons Button {
    margin-left: 1;
}

AddScreen {
    align: center middle;
}

/* Scrolls rather than pushing its buttons off a short terminal. */
#add-dialog {
    width: 76;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    overflow-y: auto;
    padding: 1 2;
    border: thick $accent;
    background: $surface;
}

#add-heading {
    padding-bottom: 1;
}

/* The destination hint carries the bucket-root warning. Full width so a long
   warning wraps instead of clipping, and a floor of two lines so the dialog
   does not jump as the message changes. */
#add-into-hint {
    width: 1fr;
    height: auto;
    min-height: 2;
    padding-bottom: 1;
}

#add-preview {
    height: auto;
    max-height: 12;
    overflow-y: auto;
    padding: 1 0;
}

#add-progress {
    width: 100%;
    padding-bottom: 1;
}
